# Enable Bluetooth Classic (Bluedroid) + SPP for the STM32 bridge.
# BLE is deliberately disabled: the bridge only needs Classic SPP.
# PlatformIO's -D CONFIG_BT_* build flags do NOT enable the bt component;
# ESP-IDF component selection is driven by these Kconfig settings.

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y

CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y

# Hardware verified with esptool flash_id: JEDEC c4:6016, 4MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
